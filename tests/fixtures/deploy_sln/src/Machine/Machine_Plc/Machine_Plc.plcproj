<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Name>Machine_Plc</Name>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="FB_Remote.TcPOU">
