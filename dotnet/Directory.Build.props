<Project>

  <!-- Shared build settings for every TcKit .NET project. See CONVENTIONS.md.

       Target frameworks are declared per project: plain net8.0 everywhere (the server and
       the xml writer backend run on Linux, ADR-0017), with the COM/UIA-touching projects
       (Automation, Server, Cli) multi-targeting net8.0;net8.0-windows so shipped Windows
       artefacts keep the WPF-profile UIA lane (ADR-0014). The COM lane carries explicit
       [SupportedOSPlatform("windows")] attributes; CA1416 guards the call sites. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Strict by default: the analogue of the Python side's `strict` mypy + ruff gate. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML docs on public APIs are a convention, not a build gate. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- COM interop lives only in adapter projects; they opt in explicitly. -->
  </PropertyGroup>

</Project>
