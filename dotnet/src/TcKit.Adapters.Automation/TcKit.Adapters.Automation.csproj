<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TcKit.Core\TcKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TcKit.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWPF drops System.IO from the implicit usings (Shapes.Path collision guard); this
         project uses no WPF namespaces, so restore it. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <PropertyGroup>
    <!-- net8.0 flavour: COM-free consumers (the Linux server lane, the test project).
         net8.0-windows flavour: what Windows artefacts ship, with the UIA lane below. -->
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- System.Windows.Automation (the UIA client) ships with the WPF profile of the Windows
         Desktop framework; needed for the Express-edition Error List read (ADR-0014). WPF gates
         on the windows TFM (UseWPF is invalid on plain net8.0), so the UIA lane rides the
         net8.0-windows flavour — which is what every shipped Windows artefact consumes.
         Overridable for local verification via -p:TcKitUiaLane=false. -->
    <TcKitUiaLane Condition="'$(TcKitUiaLane)' == '' and '$(TargetFramework)' == 'net8.0-windows'">true</TcKitUiaLane>
    <TcKitUiaLane Condition="'$(TcKitUiaLane)' == ''">false</TcKitUiaLane>
    <UseWPF Condition="'$(TcKitUiaLane)' == 'true'">true</UseWPF>
    <DefineConstants Condition="'$(TcKitUiaLane)' == 'true'">$(DefineConstants);TCKIT_UIA</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TcKitUiaLane)' != 'true'">
    <Compile Remove="ErrorListUia.cs" />
  </ItemGroup>

</Project>

