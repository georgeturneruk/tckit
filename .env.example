# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Absolute path to the TwinCAT solution or project file
PLC_PROJECT_PATH=

# URL of the Windows bridge service (e.g. http://192.168.1.100:8765)
# Leave empty if running bridge locally on the same machine
BRIDGE_URL=http://localhost:8765

# XAE attach mode: 'attach' connects to a running XAE instance
# Use 'headless' for CI (spawns invisible XAE)
XAE_MODE=attach

# AMS Net ID of the target PLC or VM (e.g. 192.168.1.100.1.1)
TARGET_AMS_ID=

# TcXaeShell COM version — do not change unless you've verified your XAE version
COM_VERSION=17.0
