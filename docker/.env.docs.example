# Docs compose environment — copy to docker/.env.docs and fill in your values.
# This file is gitignored (only the .example is committed).

# Path to the TwinCAT PLC project directory (read-only mount into container).
# Use absolute paths. Default generates from the sample fixtures.
DOCS_PLC_PATH=C:/tckit/tests/fixtures/sample_project

# Host path where generated HTML will be written.
DOCS_OUTPUT=C:/tckit/docs-output
