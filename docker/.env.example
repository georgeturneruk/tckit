# Docker environment file — copy to docker/.env and fill in your values.
# This file is gitignored.

# Project to document in the docs service (filesystem path inside the
# container). Bridge-backed tools follow the solution open in the attached
# XAE and don't use this.
PROJECT_PATH=
PLC_PROJECT_NAME=
BRIDGE_URL=http://host.docker.internal:8765
XAE_MODE=attach
TARGET_AMS_ID=
COM_VERSION=17.0

# Host directory mounted read-only as /projects inside the container.
# Defaults to ./projects relative to docker/. Override if your PLC
# projects live elsewhere on the host (e.g. C:/Work/PLC).
# PLC_PROJECTS_HOST_PATH=

# Optional build tuning (uncomment to override harness defaults).
# TCKIT_BUILD_TIMEOUT=600
# TC_BUILD_CONFIG=Release
# TC_BUILD_PLATFORM=TwinCAT RT (x64)

# Safety settings for destructive operations (deploy, start_runtime).
# By default these require explicit confirmed=True — do not disable on shared or production networks.
# SAFETY_CONFIRMATIONS=true     # Set to false to allow fully autonomous operation (trusted closed networks only)
# ALLOWED_NETIDS=               # Comma-separated NetIds that bypass confirmation (e.g. test VMs, local simulators)
# BLOCKED_NETIDS=               # Comma-separated NetIds permanently blocked regardless of confirmed=True
#                                 Precedence: BLOCKED > ALLOWED > SAFETY_CONFIRMATIONS > confirmed=True
