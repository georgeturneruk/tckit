# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Absolute path to the TwinCAT solution or project file
PLC_PROJECT_PATH=

# Name of the PLC sub-project under TIPC. Optional — leave blank when there's
# exactly one PLC project in the solution (the harness auto-resolves).
PLC_PROJECT_NAME=

# URL of the Windows bridge service (e.g. http://192.168.1.100:8765)
# Leave empty if running bridge locally on the same machine
BRIDGE_URL=http://localhost:8765

# XAE attach mode: 'attach' connects to a running XAE instance
# Use 'headless' for CI (spawns invisible XAE)
XAE_MODE=attach

# AMS Net ID of the target PLC or VM (e.g. 192.168.1.100.1.1)
TARGET_AMS_ID=

# TcXaeShell COM version — do not change unless you've verified your XAE version
COM_VERSION=17.0

# Build timeout in seconds for the /build endpoint. Default 600.
# TCKIT_BUILD_TIMEOUT=600

# Override path to TcXaeShell.exe used by the structured-errors fallback
# (devenv /rebuild /log). Auto-discovered from the standard install location
# if unset.
# DEVENV_PATH=

# Build configuration / platform passed to devenv when retrieving structured
# errors. Defaults: Release / TwinCAT RT (x64).
# TC_BUILD_CONFIG=Release
# TC_BUILD_PLATFORM=TwinCAT RT (x64)

# Optional: paths to large reference projects for ad-hoc developer testing
# (manual exploration of get_structure/get_pou_interface/get_pou_item against
# realistic codebases). Not used by the automated test suite, which uses
# tests/fixtures/sample_project/.
# TCOPEN_PATH=C:\TcOpen
# TCUNIT_PATH=C:\TcUnit
