# TcKit user-global config (~/.tckit/config.toml)
#
# Read by the MCP server when running in stdio mode (the default for the
# plugin install path). Equivalent to docker/.env in the Docker mode.
#
# Precedence (highest first):
#   1. Process environment variables (uppercased, e.g. TARGET_AMS_ID)
#   2. Project config.json (or path from TCKIT_CONFIG)
#   3. This file
#   4. Built-in defaults
#
# All keys are optional. Set the ones that apply to your machine.

# ---------------------------------------------------------------------------
# TwinCAT runtime target
# ---------------------------------------------------------------------------

# AMS Net ID of the PLC or test VM you usually deploy to.
# Format: six dot-separated octets, e.g. 192.168.1.100.1.1
TARGET_AMS_ID = ""

# AMS Net IDs that bypass the deploy/start_runtime confirmation gate.
# Use for known-safe test targets (test VMs, local simulators).
# Comma-separated, same format as TARGET_AMS_ID.
ALLOWED_NETIDS = ""

# AMS Net IDs that are permanently blocked. Cannot be bypassed.
# Use for production targets you never want the agent to touch from this machine.
BLOCKED_NETIDS = ""

# Confirmation gate for deploy / start_runtime. Default: "true".
# Set to "false" only on closed networks where fully autonomous operation is acceptable.
SAFETY_CONFIRMATIONS = "true"

# ---------------------------------------------------------------------------
# Bridge service (Windows-side PowerShell HTTP listener)
# ---------------------------------------------------------------------------

# URL of the bridge. Default localhost:8765 if running on the same machine
# as the MCP server. Use the LAN address if the bridge is elsewhere.
BRIDGE_URL = "http://localhost:8765"

# XAE attach mode. "attach" connects to a running TcXaeShell instance.
# "headless" spawns an invisible one for CI.
XAE_MODE = "attach"

# TcXaeShell COM version. Do not change unless you've verified yours.
COM_VERSION = "17.0"

# ---------------------------------------------------------------------------
# Default project (optional convenience)
# ---------------------------------------------------------------------------

# If you mostly work on one project, set its absolute path here so you don't
# have to repeat it on every tool call.
PLC_PROJECT_PATH = ""

# Name of the PLC sub-project under TIPC. Leave blank when there's exactly
# one PLC project in the solution (the harness auto-resolves).
PLC_PROJECT_NAME = ""

# ---------------------------------------------------------------------------
# Build tuning (optional)
# ---------------------------------------------------------------------------

# Build timeout in seconds. Default 600.
# TCKIT_BUILD_TIMEOUT = "600"

# Build config / platform passed to devenv when retrieving structured errors.
# Defaults: Release / "TwinCAT RT (x64)".
# TC_BUILD_CONFIG = "Release"
# TC_BUILD_PLATFORM = "TwinCAT RT (x64)"
