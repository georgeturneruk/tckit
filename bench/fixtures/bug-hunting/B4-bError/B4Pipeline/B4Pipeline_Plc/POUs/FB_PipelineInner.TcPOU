<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_PipelineInner" Id="{6f142fce-0f36-4400-bf35-bea414d7e9ac}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PipelineInner
VAR_INPUT
    value : INT;
END_VAR
VAR_OUTPUT
    bError : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Inner raises an error for any negative input.
bError := value < 0;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>